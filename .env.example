# Copy to .env for local development. Never commit the real file.

# --- required -------------------------------------------------------------
# Postgres with the pgvector extension. On Neon use the POOLED connection
# string (the one containing "-pooler") and keep sslmode=require.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=

# --- deployment -----------------------------------------------------------
# "production" makes ALLOWED_ORIGINS mandatory. Left unset, the app runs in
# development mode and accepts any localhost origin.
ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API. REQUIRED in
# production; without it CORS would silently fall back to localhost only and
# the deployed frontend would fail with opaque errors.
# ALLOWED_ORIGINS=https://your-frontend.onrender.com

# --- tuning (all optional, defaults shown) --------------------------------
# MAX_UPLOAD_MB=5
# MAX_CHUNKS_PER_DOCUMENT=1200
# MAX_DOCUMENTS_PER_SESSION=5
# MAX_CHUNKS_PER_SESSION=3000
# SESSION_TTL_DAYS=7
# ASK_RATE_LIMIT=10/minute;100/day
# UPLOAD_RATE_LIMIT=3/minute;20/day
# DB_POOL_MIN=1
# DB_POOL_MAX=10
